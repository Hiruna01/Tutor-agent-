# Dependencies — never commit these; Vercel/CI install them fresh.
# (Committing node_modules from Windows drops the Unix exec bit on binaries
#  like .bin/vite, causing "Permission denied" / exit 126 on Linux builds.)
node_modules/

# Build output
dist/
dist-ssr/

# Vite / tooling caches
.vite/
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
