# Copy this file to .env and choose one authentication method.

# Google AI Studio (fastest for a workshop) — get a key at https://aistudio.google.com/
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-ai-studio-api-key

# Vertex AI (use these instead of GOOGLE_API_KEY)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
