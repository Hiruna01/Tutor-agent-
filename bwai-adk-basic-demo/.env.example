# Copy this file to .env and fill in your keys.
#
# This project uses a HYBRID model setup:
#   - The tutor agent runs on OpenRouter (needs OPENROUTER_API_KEY).
#   - The web-search sub-agent runs on the native Google API, because the
#     built-in google_search tool only works there (needs GOOGLE_API_KEY).
# Both keys are required for the full experience.

# OpenRouter — powers the tutor. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Google AI Studio — powers the live web-search sub-agent (google_search).
# Get a key at https://aistudio.google.com/
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-ai-studio-api-key

# Vertex AI (alternative to GOOGLE_API_KEY for the search agent)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
